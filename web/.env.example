# web/ 프론트엔드 환경변수 템플릿
# web/.env.local 로 복사한 뒤 값을 채운다. .env.local 은 커밋하지 않는다.
#   PowerShell: Copy-Item web\.env.example web\.env.local
# 전부 비워 둬도 동작한다.

VITE_API_BASE_URL=http://127.0.0.1:8000

# 영수증을 대조할 Sepolia 공개 RPC (CORS 허용 필요). 비우면 publicnode 를 쓴다.
VITE_SEPOLIA_RPC_URL=
# 개발 중 로컬 hardhat 노드(체인ID 31337)의 기록도 믿을지. 1 이면 contract/deployments/localhost.json 을 읽는다.
VITE_ALLOW_LOCAL_CHAIN=
