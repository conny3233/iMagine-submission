# 환경변수 템플릿 — 동의 영수증
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다 (.gitignore 에 이미 등록).
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ── Claude API ──
# console.anthropic.com → Settings → API Keys 에서 발급. Claude Code 구독과는 별개 과금.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5       # 공모전 시연에서 답변 품질이 그대로 노출된다. 크레딧이 아쉬우면 claude-sonnet-5
LLM_MODE=fixture              # fixture | live   (fixture = 저장된 응답 사용, 네트워크·크레딧 불필요)
LLM_EFFORT=low                # low | medium | high | xhigh | max — 대화 응답 속도와 사고 깊이의 균형
LLM_MAX_TOKENS=8000

# ── API 서버 ──
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 블록체인 ── Sepolia 테스트넷: 체인ID 11155111 / 통화 SepoliaETH
# 기록은 두 길: 앱 ①에서 방금 한 동의 = 기록 서버(web/api/record.js, RECORDER_PRIVATE_KEY),
# 미리 적어 둘 영수증 = contract/scripts/record-receipts.js (DEPLOYER_PRIVATE_KEY). 화면은 공개 RPC 로 읽기만 한다.
# 계약 주소는 여기 적지 않는다 — 배포 스크립트가 contract/deployments/sepolia.json 에 남기고 앱이 그 파일을 읽는다.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=         # cd contract && npm run wallet 이 채운다. 테스트넷 전용. 실자산 지갑 금지. 커밋 절대 금지.
DEPLOYER_ADDRESS=             # 위 키의 주소 (공개 정보, 참고용)
ETHERSCAN_API_KEY=            # (선택) Etherscan 소스 공개용. 없으면 Sourcify 로만 공개된다.
RECORDER_PRIVATE_KEY=         # 앱 기록 서버 지갑 (배포 지갑과 분리). Vercel 환경변수에도 같은 값. 커밋 절대 금지.
RECORDER_ADDRESS=             # 위 키의 주소 (공개 정보)
